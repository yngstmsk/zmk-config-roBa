<Window x:Class="RoBaKeymapOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="roBa Keymap Overlay"
        Width="900"
        Height="320"
        MinWidth="200"
        MinHeight="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="EditBarRow" Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar"
                Grid.Row="0"
                Visibility="Collapsed"
                Background="#DD2A3344"
                BorderBrush="#8899AABB"
                BorderThickness="1,1,1,0"
                CornerRadius="6,6,0,0"
                Padding="10,6"
                Cursor="SizeAll"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
            <TextBlock x:Name="TitleBarText"
                       Foreground="White"
                       FontSize="12"
                       Text="roBa Keymap — ドラッグで移動 / 端でリサイズ / Ctrl+Alt+L でロック" />
        </Border>

        <Border x:Name="DragArea"
                Grid.Row="1"
                Background="Transparent"
                Cursor="SizeAll"
                MouseLeftButtonDown="DragArea_OnMouseLeftButtonDown">
            <Grid>
                <Canvas x:Name="KeymapCanvas"
                        ClipToBounds="True"
                        Background="Transparent" />
                <TextBlock x:Name="LockedHint"
                           Visibility="Collapsed"
                           Text="ロック中 — Ctrl+Alt+L またはトレイから編集モード"
                           Foreground="#CCFFFFFF"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,6"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Border x:Name="EditBar"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="#CC1E2430"
                BorderBrush="#66778899"
                BorderThickness="0,1,0,0"
                Padding="10,8"
                MouseLeftButtonDown="EditBar_OnMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="透明度"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <Slider x:Name="OpacitySlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        Value="85"
                        VerticalAlignment="Center"
                        ValueChanged="OpacitySlider_OnValueChanged" />

                <TextBlock x:Name="OpacityLabel"
                           Grid.Column="2"
                           Text="85%"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Width="44"
                           TextAlignment="Right"
                           Margin="10,0,10,0" />

                <Button x:Name="LockButton"
                        Grid.Column="3"
                        Content="ロック"
                        Padding="14,4"
                        Click="LockButton_OnClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
